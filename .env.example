# Meridian — Daily Brief environment variables
#
# Copy to .env.local and fill in. Vercel: paste values into
# Project Settings → Environment Variables. All keys are optional for V1
# — missing keys cause the corresponding section to fall back to the
# hand-curated mock data in lib/mock-brief.ts.

# Anthropic — prose generation for chart takeaway + idea blurb
# Required for any live LLM prose. Without it the brief falls back to
# the hardcoded copy in lib/mock-brief.ts.
ANTHROPIC_API_KEY=

# FRED — St. Louis Fed macro time series (free)
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub — earnings calendar + US ticker quotes (free, 60 req/min)
# Register: https://finnhub.io/register
FINNHUB_API_KEY=

# BPS WebAPI — Indonesia statistics (CPI, GDP, trade) (free)
# Register: https://webapi.bps.go.id
BPS_API_KEY=

# Vercel Cron auth — random string. Vercel auto-sends as Bearer header.
# Generate: `openssl rand -hex 32`
# Without it, the cron endpoint accepts unauthenticated requests
# (useful in dev; set this before going to production).
CRON_SECRET=
